    {
      "id": "chemistry",
      "argv": [
        ".venv/Scripts/python.exe",
        "-X",
        "utf8",
        "-m",
        "unittest",
        "discover",
        "-s",
        "app_tests",
        "-p",
        "test_*.py",
        "-v"
      ],
      "timeout_seconds": 180
    }
  ],
  "acceptance": [
    {
      "id": "AC-LOCAL",
      "criterion": "The duplicate static-build Python dependency folder is excluded while API and native runtime dependencies remain; TypeScript and chemistry regressions pass.",
      "method": "command",
      "check_ids": [
        "bundle",
        "build",
        "chemistry"
      ]
    },
    {
      "id": "AC-REMOTE",
      "criterion": "The corrected commit is on GitHub main; the connected Vercel build succeeds and the public UI, RDKit API and browser flows work. A build failure or unavailable remote validation remains incomplete.",
      "method": "review",
      "reviewer": "agent"
    }
  ],
  "limits": {
    "max_no_progress_attempts": 2,
    "total_check_seconds": 600
  }
