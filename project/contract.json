{
  "schema_version": "4.0",
  "task_id": "chemistry-studio-rename-20260915",
  "request_reference": "Rename user-facing 분자 스튜디오 to 모두의 화학 스튜디오.",
  "permissions": {
    "local_checks": true
  },
  "source_paths": [
    "src/App.tsx",
    "index.html",
    "docs/USER_GUIDE.md"
  ],
  "deliverables": [
    "dist/index.html",
    "src/App.tsx",
    "index.html",
    "docs/USER_GUIDE.md"
  ],
  "checks": [
    {
      "id": "typecheck",
      "argv": [
        "node",
        "node_modules/typescript/bin/tsc",
        "--noEmit"
      ],
      "timeout_seconds": 90
    }
  ],
  "acceptance": [
    {
      "id": "AC-BUILD",
      "criterion": "TypeScript check passes.",
      "method": "command",
      "check_ids": [
        "typecheck"
      ]
    },
    {
      "id": "AC-NAME",
      "criterion": "New brand, accessible home link, browser title/description and guide title agree; production build and desktop/mobile visual review pass; public deployment shows the new name and automation session is closed.",
      "method": "review",
      "reviewer": "agent"
    }
  ],
  "limits": {
    "max_no_progress_attempts": 2,
    "total_check_seconds": 120
  }
}
