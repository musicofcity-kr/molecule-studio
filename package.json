{
  "name": "molecule-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:api": "python -X utf8 api/molecule.py",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1",
    "test:chemistry": "python -X utf8 -m unittest discover -s app_tests -p test_*.py -v",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "html-to-image": "1.11.13",
    "lucide-react": "1.45.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "agent-browser": "0.37.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
