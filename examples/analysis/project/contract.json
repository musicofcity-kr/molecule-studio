{
  "schema_version": "4.0",
  "task_id": "example-analysis",
  "request_reference": "합성 예제 계약; 사용자의 실제 승인이나 실험 결과가 아님",
  "permissions": {
    "local_checks": true
  },
  "source_paths": [
    "work"
  ],
  "deliverables": [
    "work/result.json"
  ],
  "checks": [
    {
      "id": "local-check",
      "argv": [
        "{python}",
        "work/check.py"
      ],
      "timeout_seconds": 20
    }
  ],
  "acceptance": [
    {
      "id": "AC-RUN",
      "criterion": "합성 예시: CSV의 값 3개를 읽어 개수·평균·단위와 자료의 합성 여부를 보고한다.",
      "method": "command",
      "check_ids": [
        "local-check"
      ]
    }
  ]
}
